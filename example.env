DISCORD_TOKEN=
DISCORD_CLIENT_ID=
BOT_PREFIX=,,

# Multi-owner support — comma-separated Discord user IDs (no spaces needed,
# they're trimmed automatically). Not used by any command yet — reserved
# for future owner-only features.
OWNER_IDS=738383838383838383,738288282828282828

# ── Branding ─────────────────────────────────────────────────────────────────
# Used in every embed/card footer across the whole bot (help, ping, mention
# reply, auth cards, DM notices, and the success/error web pages).
BOT_NAME=Synora 乂 𝙳evelopment
SUPPORT_SERVER_LINK=https://dsc.gg/synoraxdev

# ── /authlink OAuth2 system ──────────────────────────────────────────────────
# This runs INSIDE the same process as the bot (see index.js -> startAuthServer),
# using your Pterodactyl server's SECOND allocation/port (not the main one the
# bot itself is already bound to).
#
# Client Secret from Discord Developer Portal > OAuth2 > Client Information
DISCORD_CLIENT_SECRET=
# Must EXACTLY match a "Redirect" URL added in Discord Developer Portal > OAuth2
# e.g. http://wings.hostigo.cloud:3003/callback
REDIRECT_URI=
# The SECOND allocated port shown in Pterodactyl > Network (not the main 3002-style
# one already used by the bot's gateway connection).
AUTH_SERVER_PORT=3003
# Set to "true" to auto-join verified members into the guild (requires the
# bot to already be a member of the target guild).
# Reuses DISCORD_TOKEN above for the join API call — no separate token needed.
AUTO_JOIN_GUILD=false
